                                "any"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "f1"
                        }
                    ],
                    "conditions": [
                        {
                            "type": "device_if",
                            "identifiers": [
                                {
                                    "vendor_id": 1452,
                                    "product_id": 591,
                                    "is_keyboard": true,
                                    "is_pointing_device": true
                                }
                            ]
                        },
